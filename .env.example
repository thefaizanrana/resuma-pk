# Copy to .env and fill in real values. NEVER commit .env to git.

DEBUG=True

# Production only - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of hosts this site may serve
ALLOWED_HOSTS=localhost,127.0.0.1,www.resuma.pk,resuma.pk,.vercel.app

# Comma-separated list of origins allowed for CSRF (production)
CSRF_TRUSTED_ORIGINS=https://www.resuma.pk,https://resuma.pk,https://*.vercel.app

# PostgreSQL connection string. Leave empty to use local SQLite.
DATABASE_URL=

# Email (production). Leave blank to print emails to console in dev.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@resuma.pk
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@resuma.pk